# Agent API
# Copy to .env and replace values. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
MAX_AGENT_MODE=simulated
MAX_COMMERCE_MODE=simulated
MAX_PAYMENT_MODE=simulated
# Master kill switch for submitting an external merchant checkout. Keep false
# until the exact quote, Prava approval, provider login, and dry-run evidence
# have all been verified.
MAX_PURCHASE_ENABLED=false
MAX_RUNTIME_ENVIRONMENT=local
MAX_ADMIN_TOKEN=replace-with-a-long-random-value
MAX_DATABASE_URL=sqlite:///max.db
MAX_WEB_ORIGIN=http://127.0.0.1:5173
# Public HTTPS host used by the production Caddy container.
MAX_PUBLIC_HOST=

# Required only when MAX_PAYMENT_MODE=prava.
PRAVA_SECRET_KEY=sk_test_replace_me
PRAVA_ENVIRONMENT=sandbox
PRAVA_USER_ID=max-demo-owner
PRAVA_USER_EMAIL=
# Optional. When set, hosted checkout redirects here and the URL must be HTTPS.
PRAVA_CALLBACK_URL=

# Dedicated, logged-in Chromium instance used only for the final Swiggy card form.
SWIGGY_CDP_URL=http://127.0.0.1:9222
SWIGGY_CARDHOLDER_NAME=
SWIGGY_CHECKOUT_TIMEOUT_SECONDS=20
# The backend records every distinct Swiggy order state. Only the normalized
# ARRIVED_AT_DELIVERY_LOCATION state can create a fail-closed dry-run Pi job.
MAX_ORDER_SYNC_INTERVAL_SECONDS=5
MAX_ORDER_SYNC_ERROR_INTERVAL_SECONDS=30
MAX_ORDER_SYNC_STATE_FILE=/data/order-sync-worker.json

# Optional authenticated Pi mission bridge. Keep dry-run enabled until the
# navigation stack has repeatable physical-route evidence.
MAX_ROBOT_MODE=simulated
MAX_ROBOT_URL=http://127.0.0.1:8081
MAX_ROBOT_TOKEN=
MAX_ROBOT_DRY_RUN=true
MAX_ROBOT_HEARTBEAT_STALE_SECONDS=30
MAX_TELEOP_ENABLED=false
MAX_TELEOP_DEADMAN_MS=350
MAX_TELEOP_MAX_CLIENT_AGE_MS=1000
MAX_TELEOP_CONTROLLER_IDLE_SECONDS=6
MAX_TELEOP_AGENT_IDLE_SECONDS=10
MAX_TELEOP_STATE_FILE=/data/teleop-state.json

# Owner-only Telegram control plane. Create the bot with BotFather, send it
# /start, then use `max-telegram-setup discover` to obtain your numeric user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_ID=
MAX_CONTROL_API_URL=http://127.0.0.1:8000
MAX_TELEGRAM_WORKER_INTERVAL_SECONDS=5
# Keep false during setup and dry-runs. When true, successful Prava verification
# authorizes the worker to submit the exact approved Swiggy quote once.
MAX_TELEGRAM_AUTO_CHECKOUT=false

# Use pi_poll when the API is public and the Pi must connect outbound.
# MAX_ROBOT_MODE=pi_poll
# MAX_ROBOT_POLL_INTERVAL_SECONDS=5
