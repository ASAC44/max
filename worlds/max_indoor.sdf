<?xml version="1.0"?>
<sdf version="1.11">
  <world name="max_indoor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 6 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 6 0.1</size></box></geometry>
          <material><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static><pose>0 3 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>8 0.1 2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>8 0.1 2</size></box></geometry><material><diffuse>0.8 0.3 0.25 1</diffuse></material></visual></link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -3 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>8 0.1 2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>8 0.1 2</size></box></geometry><material><diffuse>0.2 0.65 0.3 1</diffuse></material></visual></link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>4 0 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 6 2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.1 6 2</size></box></geometry><material><diffuse>0.25 0.4 0.8 1</diffuse></material></visual></link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-4 0 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 6 2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.1 6 2</size></box></geometry><material><diffuse>0.75 0.7 0.2 1</diffuse></material></visual></link>
    </model>

    <model name="pickup_counter">
      <static>true</static><pose>2.8 2.2 0.45 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.3 0.5 0.9</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.3 0.5 0.9</size></box></geometry><material><diffuse>0.55 0.25 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="tag_home">
      <static>true</static><pose>-3.93 0 0.7 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.01 0.225 0.225</size></box></geometry>
      <material><pbr><metal><albedo_map>model://max_robot/tag36h11_0.pgm</albedo_map></metal></pbr></material></visual></link>
    </model>
    <model name="tag_turn">
      <static>true</static><pose>3.93 0 0.7 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.01 0.225 0.225</size></box></geometry>
      <material><pbr><metal><albedo_map>model://max_robot/tag36h11_1.pgm</albedo_map></metal></pbr></material></visual></link>
    </model>
    <model name="tag_pickup">
      <static>true</static><pose>2 2.93 0.7 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.225 0.01 0.225</size></box></geometry>
      <material><pbr><metal><albedo_map>model://max_robot/tag36h11_2.pgm</albedo_map></metal></pbr></material></visual></link>
    </model>

    <model name="movable_obstruction">
      <pose>3.2 -2.2 0.25 0 0 0</pose>
      <link name="link">
        <inertial><mass>1</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <include><uri>model://max_robot</uri></include>
  </world>
</sdf>
