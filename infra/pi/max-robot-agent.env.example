MAX_CONTROL_API_URL=https://max.example.com
MAX_ROBOT_TOKEN=replace-with-the-backend-robot-token
MAX_ROBOT_ID=max-pi

# Use false only with `install-agent.sh autonomous` after commissioning.
MAX_ROBOT_DRY_RUN=true
MAX_ROBOT_REHEARSAL=false
MAX_OPERATOR_PIN=replace-with-a-private-operator-pin
MAX_LOCAL_ROBOT_URL=http://127.0.0.1:8080

# Required by max-navigation.service in autonomous mode.
MAX_NAVIGATION_DATABASE=/var/lib/max-robot/navigation/max_rtabmap.db
MAX_NAVIGATION_REFERENCE_DIR=/var/lib/max-robot/navigation/references
MAX_NAVIGATION_MOTOR_CONFIG=/etc/max-robot/motors.yaml
# Set this to a private route containing the measured pulley checkpoint.
MAX_NAVIGATION_ROUTE=/etc/max-robot/route.json
MAX_NAVIGATION_TAG_CONFIG=/etc/max-robot/tags.yaml

MAX_ROBOT_POLL_INTERVAL_SECONDS=5
MAX_ROBOT_HEARTBEAT_INTERVAL_SECONDS=10

# Remote teleoperation remains latched in emergency stop until an authenticated
# controller explicitly resets it. This agent emits only W/A/S/D, Space, 1-5.
MAX_TELEOP_INPUT_ENABLED=true
MAX_TELEOP_UINPUT_DEVICE=/dev/uinput
MAX_TELEOP_INPUT_DEVICE_NAME=Max Remote Teleop
MAX_TELEOP_LOG_LEVEL=INFO

# Versioned BTS7960/horn consumer for the dedicated virtual keyboard.
MAX_DRIVE_INITIAL_SPEED=0.30
MAX_DRIVE_HORN_FILE=/home/pi/.local/share/prava/truck-horn.mp3
MAX_DRIVE_LEFT_INVERTED=false
MAX_DRIVE_RIGHT_INVERTED=false
MAX_DRIVE_ALLOW_PHYSICAL_KEYBOARD=true

# Presence probes. A present device is not automatically considered calibrated.
MAX_CAMERA_DEVICE=/dev/media0
MAX_GPS_DEVICE=/dev/serial0
MAX_IMU_DEVICE=/dev/i2c-1
MAX_AUDIO_STATUS_FILE=/proc/asound/cards

# Leave unset until a normally-closed physical emergency-stop input is installed.
# MAX_ESTOP_DEVICE=/dev/...
