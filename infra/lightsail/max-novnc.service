[Unit]
Description=Max loopback-only noVNC gateway
After=max-vnc.service
Requires=max-vnc.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/websockify --web=/usr/share/novnc/ 127.0.0.1:6080 127.0.0.1:5900
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
