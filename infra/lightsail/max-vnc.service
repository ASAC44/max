[Unit]
Description=Max loopback-only VNC server
After=max-xvfb.service
Requires=max-xvfb.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/x11vnc -display :99 -localhost -forever -shared -nopw -rfbport 5900
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
