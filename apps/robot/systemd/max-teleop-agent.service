[Unit]
Description=Max authenticated remote teleoperation input agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=input
EnvironmentFile=/etc/max-robot/agent.env
ExecStart=/opt/max-robot/venv/bin/max-teleop-agent
Restart=always
RestartSec=2
TimeoutStopSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
